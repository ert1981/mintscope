# Copy to .env and fill in only what you have. Nothing here is required to start the app.

# auto = live if OPENSEA_API_KEY is set, otherwise demo. Allowed: auto | demo | live
MINTSCOPE_MODE=auto

# Optional: OpenSea API key for live data. Leave empty to run in demo mode.
OPENSEA_API_KEY=

# Optional shared API token. Set a long random value before public deployment.
# If configured, /analyze, /reports/* and /ledger require X-API-Token.
MINTSCOPE_API_TOKEN=

# Local storage (SQLite file). Excluded from git.
MINTSCOPE_DB_PATH=mintscope.db

# Local usage limits
MINTSCOPE_RATE_LIMIT_PER_MINUTE=30
MINTSCOPE_MAX_LIVE_CALLS_PER_DAY=200
MINTSCOPE_REQUEST_TIMEOUT_SECONDS=10

# Total budget in USD; no paid call is made if it would exceed this.
MINTSCOPE_BUDGET_USD=2.00

# ERC-8257 tool manifest for OpenSea Tools (served at /.well-known/ai-tool/mintscope-nft-analysis.json).
# Public HTTPS origin of this service, e.g. https://mintscope.example.com (no trailing slash).
MINTSCOPE_PUBLIC_BASE_URL=
# Lowercase EVM address of the wallet that will call registerTool. Public address only, never a private key.
MINTSCOPE_CREATOR_ADDRESS=

# Optional manifest display images (https only). Square icon, and a 16:9 banner (needed to be considered
# for the featured section of opensea.io/tools).
MINTSCOPE_IMAGE_URL=
MINTSCOPE_FEATURED_IMAGE_URL=

# Pricing (v0.6). on = free tier (3/month) + paid full reports; off = everything free.
MINTSCOPE_PRICING=on
# PUBLIC address that receives USDC (never a private key). Empty = paid tier disabled.
MINTSCOPE_PAYEE_ADDRESS=
MINTSCOPE_PRICE_USDC=2.99
MINTSCOPE_FREE_PER_MONTH=3
# base = real USDC on Base; base-sepolia = test USDC for trials
MINTSCOPE_X402_NETWORK=base
# x402 facilitator (PayAI is free and needs no key)
MINTSCOPE_X402_FACILITATOR_URL=https://facilitator.payai.network

# ---- v0.7 ----
# Local app mode is set automatically by `mintscope local`; keys are entered in the UI (Settings), not here.
# MINTSCOPE_CONFIG_DIR=
# MINTSCOPE_KEYSTORE=file
# Admin API for Featured Collections (24+ random characters). Leave empty to disable the admin API.
MINTSCOPE_ADMIN_TOKEN=
# Sponsored slots stay off until there is an audience.
MINTSCOPE_SPONSORED_ENABLED=off
# Local apps can read Featured from your hosted server:
MINTSCOPE_FEATURED_FEED_URL=
MINTSCOPE_SUBMISSIONS_PER_DAY=5
